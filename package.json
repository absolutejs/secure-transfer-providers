{
  "name": "@absolutejs/secure-transfer-providers",
  "private": true,
  "type": "module",
  "workspaces": [
    "webcrypto"
  ],
  "scripts": {
    "build": "bun run --filter './*' build",
    "certify:browser": "bun run scripts/certify-browser.ts",
    "check:package": "bun run format:check && bun run typecheck && bun run test && bun run build && bun run --filter './*' verify-package",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"./**/*.{ts,json,md}\"",
    "test": "bun run --filter './*' test",
    "typecheck": "bun run --filter './*' typecheck"
  },
  "devDependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@absolutejs/secure-transfer": "https://registry.npmjs.org/@absolutejs/secure-transfer/-/secure-transfer-0.1.1.tgz",
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.0",
    "playwright": "1.60.0",
    "typescript": "^5.9.0"
  }
}
