{
  "name": "@absolutejs/secure-transfer-webcrypto",
  "version": "0.1.1",
  "description": "WebCrypto AES-256-GCM authenticated-record provider for @absolutejs/secure-transfer.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/secure-transfer-providers.git",
    "directory": "webcrypto"
  },
  "homepage": "https://github.com/absolutejs/secure-transfer-providers/tree/main/webcrypto",
  "bugs": {
    "url": "https://github.com/absolutejs/secure-transfer-providers/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provider-manifest": {
      "types": "./dist/provider-manifest.d.ts",
      "import": "./dist/provider-manifest.js",
      "default": "./dist/provider-manifest.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/provider-manifest.ts src/manifest.ts --outdir dist --root src --sourcemap --target=browser --external @absolutejs/secure-transfer --external @absolutejs/manifest --external @sinclair/typebox && tsc --project tsconfig.build.json && absolute-manifest emit",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run build && bun run verify-package",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "release": "bun run check:package && npm publish --access public",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "verify-package": "absolute-manifest verify-package"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@absolutejs/secure-transfer": "https://registry.npmjs.org/@absolutejs/secure-transfer/-/secure-transfer-0.3.0.tgz",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@absolutejs/secure-transfer": ">=0.1.1 <0.4"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
